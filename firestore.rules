rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validPlayer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'color', 'points', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.color is string && d.color.size() <= 9
        && d.points is number;
    }

    // Player profile + points. Points can only go up, by a limited amount per write.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && validPlayer() && request.resource.data.points == 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && validPlayer()
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points - resource.data.points <= 20000;
      allow delete: if false;
    }

    // Username -> uid (unique, lowercase). Cannot be changed once created.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Friend links: doc id = "<myUid>_<friendUid>"
    match /friends/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'to'])
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // Chat: direct chats ("uidA_uidB") for the two people, guild chats ("g_<guildId>") for members
    function canChat(c) {
      return c.matches('g_.*')
        ? request.auth.uid in get(/databases/$(database)/documents/guilds/$(c.replace('g_', ''))).data.members
        : request.auth.uid in c.split('_');
    }
    match /messages/{id} {
      allow read: if request.auth != null && canChat(resource.data.chatId);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['chatId', 'from', 'text', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && canChat(request.resource.data.chatId);
      allow update, delete: if false;
    }

    // Guilds: doc id = lowercase name. Anyone can join/leave themselves (max 20 members).
    match /guilds/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() <= 20
        && ((request.auth.uid in request.resource.data.members
              && request.resource.data.members.size() == resource.data.members.size() + 1
              && request.resource.data.members.hasAll(resource.data.members))
         || (request.auth.uid in resource.data.members
              && !(request.auth.uid in request.resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() - 1));
      allow delete: if request.auth != null && resource.data.members == [request.auth.uid];
    }

    match /territories/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'geometry', 'area', 'createdAt', 'updatedAt'])
        && request.resource.data.area is number
        && request.resource.data.area >= 100
        && request.resource.data.area <= 5000000
        && request.resource.data.geometry is string
        && request.resource.data.geometry.size() < 900000;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['geometry', 'area', 'updatedAt'])
        && request.resource.data.geometry.size() < 900000;
      allow delete: if request.auth != null;
    }
  }
}
